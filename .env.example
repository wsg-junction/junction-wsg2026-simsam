# Copy to .env (repo root) for local development. .env is gitignored.

# AI answers via NVIDIA's API catalog (build.nvidia.com). Without it, Atlas
# answers from Wikipedia text only.
NVIDIA_API_KEY=
# Optional: override the model.
# NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Optional: identify the API's server-side Wikipedia requests (Wikimedia asks for
# contact details and throttles generic agents harder). Same variable as scripts/.
# WIKIPEDIA_USER_AGENT=Atlas/1.0 (https://example.com; you@example.com)

# Optional: web search through context.dev for the Context side panel, with
# context Wikipedia's articles don't cover (e.g. a war's impact on the financial
# sector). The research pages themselves stay Wikipedia only.
CONTEXT_DEV_API_KEY=

# Optional: read compact briefs aloud with ElevenLabs text to speech.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # any voice ID from your ElevenLabs account
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5      # low latency; eleven_multilingual_v2 for higher quality
# The same key also transcribes spoken follow-up questions:
# ELEVENLABS_STT_MODEL_ID=scribe_v2
